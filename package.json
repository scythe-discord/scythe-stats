{
  "name": "scythe-stats",
  "version": "2.0.0",
  "private": true,
  "description": "Scythe Stats - a site to aggregate and showcase stats for the board game Scythe, by Stonemaier Games",
  "repository": "https://github.com/scythe-discord/scythe-stats",
  "author": "Brady Shi",
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @scythe/db run db:migrate",
    "db:provision": "bash scripts/provision-db.sh",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "lefthook": "^1.8.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
