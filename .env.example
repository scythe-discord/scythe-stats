# Copy to .env and fill in. Validated at boot by @scythe/config.
NODE_ENV=development

# Local dev infra (see docker-compose.yml)
DATABASE_URL=postgres://scythe:scythe@localhost:8432/scythe
REDIS_URL=redis://:scythe@localhost:8379

# Auth.js + Discord OAuth (Phase 4)
# AUTH_SECRET: generate with `npx auth secret` (or `openssl rand -base64 32`).
AUTH_SECRET=
# From the Discord Developer Portal (https://discord.com/developers/applications)
# → your app → OAuth2. Add this redirect URL there:
#   http://localhost:3000/api/auth/callback/discord  (prod: https://<domain>/api/auth/callback/discord)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Discord match-announce (optional — all three required for posts to go out;
# unset means recording works but the announce is silently skipped).
# DISCORD_BOT_TOKEN: Developer Portal → your app → Bot. The bot must be in the
# guild with Send Messages permission in the target channel.
# GUILD_IDS / VANILLA_LOG_CHANNEL_IDS: comma-separated, position-paired lists
# (first guild posts to first channel, and so on).
DISCORD_BOT_TOKEN=
GUILD_IDS=
VANILLA_LOG_CHANNEL_IDS=
# Shown as the embed's link/footer (optional), e.g. https://belovedpacifist.com
SITE_URL=

# Google Analytics 4 measurement ID (optional), e.g. G-XXXXXXXXXX. Client-side
# and inlined at build time (NEXT_PUBLIC_*)
NEXT_PUBLIC_GA_TRACKING_ID=
